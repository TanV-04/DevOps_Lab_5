pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        IMAGE_NAME = 'litestar-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_CREDENTIALS = 'dockerhub-credentials'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                dir('LAB_PROJ_1') {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
                }
            }
        }
        
        stage('Lint and Code Quality') {
            steps {
                dir('LAB_PROJ_1') {  
                sh '''
                    . venv/bin/activate
                    pip install flake8 black
                    flake8 app/app.py --max-line-length=88 --extend-ignore=E203,W503 || true
                    black --check app/app.py || true
                '''
                }
            }
        }
        
        
        stage('Build Docker Image') {
            steps {
                dir('LAB_PROJ_1') {
                script {
                    def image = docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                    docker.withRegistry('https://registry-1.docker.io/v2/', DOCKER_CREDENTIALS) {
                        image.push()
                        image.push('latest')
                        }
                    }
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                dir('LAB_PROJ_1') {
                sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                        -v $(pwd):/tmp/.cache/ aquasec/trivy:latest \\
                        image --exit-code 0 --no-progress --format table \\
                        ${IMAGE_NAME}:${IMAGE_TAG} || true
                '''
                }
            }
        }
        
        stage('Deploy to Staging') {
            steps {
                dir('LAB_PROJ_1') {
                sh '''
                    # Stop existing container if running
                    docker stop litestar-app-staging || true
                    docker rm litestar-app-staging || true
                    
                    # Run new container
                    docker run -d \\
                        --name litestar-app-staging \\
                        --network jenkins-network \\
                        -p 8001:8000 \\
                        ${IMAGE_NAME}:${IMAGE_TAG}
                    
                    # Wait for app to start
                    sleep 10
                '''
                }
            }
        }
        
        stage('Integration Tests') {
            steps {
                dir('LAB_PROJ_1') {
                sh '''
                    # Test health endpoint
                    curl -f http://localhost:8001/ || exit 1
                    
                    # Test other endpoints
                    curl -f http://localhost:8001/hello || exit 1
                    curl -f http://localhost:8001/info || exit 1
                '''
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    input message: 'Deploy to production?', ok: 'Deploy'
                }
                dir('LAB_PROJ_1') {
                sh '''
                    # Stop existing production container
                    docker stop litestar-app-prod || true
                    docker rm litestar-app-prod || true
                    
                    # Deploy to production
                    docker run -d \\
                        --name litestar-app-prod \\
                        --network jenkins-network \\
                        -p 8000:8000 \\
                        --restart unless-stopped \\
                        ${IMAGE_NAME}:${IMAGE_TAG}
                '''
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
            // Add notification logic here (Slack, email, etc.)
        }
        failure {
            echo 'Pipeline failed!'
            // Add failure notification logic here
        }
    }
}