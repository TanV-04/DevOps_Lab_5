pipeline {
    agent any

    environment {
        IMAGE_NAME = "litestar-demo-api"
        IMAGE_TAG = "latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Run Container') {
            steps {
                script {
                    docker.image("${IMAGE_NAME}:${IMAGE_TAG}").run("-d -p 8000:8000")
                }
            }
        }

        stage('Test API') {
            steps {
                sh '''
                echo "Testing health endpoint..."
                curl -s http://localhost:8000/
                '''
            }
        }
    }

    post {
        always {
            echo 'Cleaning up...'
            sh 'docker ps -a -q | xargs -r docker rm -f'
            sh 'docker images -q | xargs -r docker rmi -f'
        }
    }
}
