pipeline {
  agent any
  environment {
    IMAGE_NAME = "flask-app"
    DOCKERHUB_REPO = "your-dockerhub/${IMAGE_NAME}"
  }
  stages {
    stage('Checkout') {
      steps {
        git 'https://github.com/your-repo/docker-flask-jenkins.git'
      }
    }
    stage('Build') {
      steps {
        script {
          dockerImage = docker.build("${IMAGE_NAME}")
        }
      }
    }
    stage('Test') {
      steps {
        script {
          dockerImage.inside {
            sh 'python app.py &'
            sleep 10
            sh 'curl http://localhost:5000'
          }
        }
      }
    }
    stage('Push') {
      steps {
        script {
          docker.withRegistry('', 'dockerhub-credentials') {
            dockerImage.push('latest')
          }
        }
      }
    }
  }
}
