pipeline {
  agent none

  options {
    timestamps()
  }

  stages {
    stage('Checkout & Compile') {
      agent { label 'compile-node' }
      tools {
        // Configure these tool names in Jenkins Global Tools
        jdk 'JDK17'
        maven 'MAVEN3'
      }
      steps {
        checkout scm
        bat 'mvn -v'
        bat 'mvn -B -DskipTests clean package'
        stash name: 'workspace', includes: '**/*'
        archiveArtifacts artifacts: 'target/**/*.jar', fingerprint: true, onlyIfSuccessful: true
      }
    }

    stage('Test') {
      agent { label 'test-node' }
      tools {
        jdk 'JDK17'
        maven 'MAVEN3'
      }
      steps {
        unstash 'workspace'
        bat 'mvn -B test'
      }
      post {
        always {
          junit 'target/surefire-reports/*.xml'
        }
      }
    }
  }
}
