  pipeline {
      agent any

      stages {
          stage('Checkout') {
              steps { checkout scm }
          }

          stage('Diagnostics') {
              steps {
                  bat '''
                    echo WORKSPACE: %WORKSPACE%
                    dir "%WORKSPACE%"
                    dir "%WORKSPACE%/Project4/demo"
                    if exist "%WORKSPACE%/Project4/demo/pom.xml" (echo Found pom.xml under Project4/demo) else (echo No pom.xml under Project4/demo)
                  '''
              }
          }

          stage('Pre-clean') {
              steps {
                  bat '''
                    if exist "%WORKSPACE%\Project4\demo\target" (
                      echo Removing existing target directory...
                      rmdir /s /q "%WORKSPACE%\Project4\demo\target"
                    ) else (
                      echo No target directory to remove.
                    )
                  '''
              }
          }

          stage('Compile') {
              steps {
                  bat '''
                    docker run --rm ^
                      -v "%WORKSPACE%":/ws ^
                      -w /ws/Project4/demo ^
                      maven:3.9-eclipse-temurin-21 mvn -B -V clean compile
                  '''
              }
          }

          stage('Test') {
              steps {
                  bat '''
                    docker run --rm ^
                      -v "%WORKSPACE%":/ws ^
                      -w /ws/Project4/demo ^
                      maven:3.9-eclipse-temurin-21 mvn -B -V test
                  '''
              }
          }
      }

      post {
          always {
              junit '**/target/surefire-reports/*.xml'
          }
      }
  }