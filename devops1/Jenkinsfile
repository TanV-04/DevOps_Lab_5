pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t flask-app .'
            }
        }
        
        stage('Run') {
            steps {
                sh 'docker rm -f demo || true'
                sh 'docker run -d --name demo -p 5000:5000 flask-app'
            }
        }
        
        stage('Test') {
            steps {
                sh 'sleep 10'
                sh 'curl http://localhost:5000/ || echo "Test failed"'
            }
        }
    }
}