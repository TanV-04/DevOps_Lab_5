pipeline {
    agent any

    environment {
        APP_NAME = 'flask-demo'
        IMAGE = "${env.DOCKERHUB_USER ?: 'local'}/${APP_NAME}"
        TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'python3 --version || true'
                sh 'pip3 --version || true'
                sh 'python3 -m venv .venv'
                sh '. .venv/bin/activate && python -m pip install --upgrade pip'
                sh '. .venv/bin/activate && pip install -r requirements.txt'
                sh '. .venv/bin/activate && python -m pytest -q'
            }
        }

        stage('Build Image') {
            steps {
                sh "docker build -t ${IMAGE}:${TAG} ."
                sh "docker tag ${IMAGE}:${TAG} ${IMAGE}:latest"
            }
        }

        stage('Deploy (Run Container)') {
            steps {
                sh 'docker rm -f demo || true'
                sh "docker run -d --name demo -p 5000:5000 ${IMAGE}:latest"
            }
        }

        stage('Smoke Test') {
            steps {
                sh 'sleep 5'
                sh 'curl -fsS http://localhost:5000/ | tee smoke.json'
            }
        }
    }
}
