pipeline {
  agent any

  environment {
    APP_NAME = 'flask-demo'
    IMAGE = "${env.DOCKERHUB_USER ?: 'local'}/${APP_NAME}"
    TAG   = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    // Run tests inside a clean Python 3.13 container
stage('Unit Tests') {
  steps {
    sh '''
      set -euxo pipefail
      # Run tests in a clean Python 3.13 container using the same jenkins_home volume
      docker run --rm \
        -v jenkins_home:/var/jenkins_home \
        -w "$WORKSPACE" \
        -e PIP_DISABLE_PIP_VERSION_CHECK=1 \
        python:3.13-slim \
        bash -lc '
          python3 -m pip install -U pip &&
          [ -f requirements.txt ] && pip3 install -r requirements.txt || true &&
          python3 -m pip install -U pytest &&
          pytest -q
        '
    '''
  }
}


    stage('Build Image') {
      steps {
        sh """
          set -euxo pipefail
          docker build -t ${IMAGE}:${TAG} .
          docker tag ${IMAGE}:${TAG} ${IMAGE}:latest
        """
      }
    }

    stage('Deploy (Run Container)') {
      steps {
        sh """
          set -euxo pipefail
          docker rm -f demo || true
          docker run -d --name demo -p 5000:5000 ${IMAGE}:latest
        """
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          set -euxo pipefail
          # On Docker Desktop (Windows/Mac), containers reach host via host.docker.internal
          # Fallback to 127.0.0.1 if needed.
          for url in "http://host.docker.internal:5000/" "http://127.0.0.1:5000/"; do
            echo "Trying $url"
            if curl -fsS "$url" | tee smoke.json; then
              exit 0
            fi
            sleep 3
          done
          echo "Smoke test failed: app didn't respond on port 5000" >&2
          exit 1
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'smoke.json', onlyIfSuccessful: false
    }
  }
}
