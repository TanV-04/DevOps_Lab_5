pipeline {
    agent any

    environment {
        APP_NAME = 'flask-demo'
        IMAGE = "${env.DOCKERHUB_USER ?: 'local'}/${APP_NAME}"
        TAG   = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // >>> THIS STAGE RUNS IN A CONTAINER, NOT ON THE HOST <<<
        stage('Unit Tests') {
            agent {
                docker {
                    image 'python:3.13-slim'
                    args '-u'   // unbuffered output
                }
            }
            steps {
                sh '''
                  set -euxo pipefail
                  python3 --version
                  python3 -m pip install --upgrade pip
                  if [ -f requirements.txt ]; then
                    python3 -m pip install -r requirements.txt
                  fi
                  python3 -m pip install -U pytest
                  python3 -m pytest -q
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh """
                  set -euxo pipefail
                  docker build -t ${IMAGE}:${TAG} .
                  docker tag ${IMAGE}:${TAG} ${IMAGE}:latest
                """
            }
        }

        stage('Deploy (Run Container)') {
            steps {
                sh """
                  set -euxo pipefail
                  docker rm -f demo || true
                  docker run -d --name demo -p 5000:5000 ${IMAGE}:latest
                """
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                  set -euxo pipefail
                  sleep 5
                  curl -fsS http://localhost:5000/ | tee smoke.json
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'smoke.json', onlyIfSuccessful: false
        }
    }
}
